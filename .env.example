# xAI API key for server-side Grok calls. Never commit a real key.
# Server only: do not put this in HTML, JavaScript, or any API response.
XAI_API_KEY=

# Placeholder only. Not a real NASA key. Do not commit a real key.
FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# Pre-launch lock. Leave PREVIEW_PASSWORD empty for a public site.
# At launch, remove PREVIEW_PASSWORD and set ALLOW_INDEXING=true.
# The password is read only from the environment. Do not commit a real value.
PREVIEW_PASSWORD=
PREVIEW_USER=georiskintel
ALLOW_INDEXING=
SITE_PRIVATE_MODE=

# Signs single-region pass links. Never commit a real value.
PPV_SECRET=

# Public origin for Slack "View on Live Map" links. Example: https://map.example.com
PUBLIC_BASE_URL=

# Optional path for the Slack alerts database.
# Defaults to /data/slack_alerts.db when /data is writable, otherwise ./slack_alerts.db
# SLACK_ALERTS_DB=

# Optional SMTP for the 07:00 Europe/London briefings and intelligence reports.
# SMTP_PASS is accepted as an alias of SMTP_PASSWORD. Leave blank to skip email.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# Durable directory for incidents.db. On Railway, mount a volume at /data.
# When unset, /data is used if it exists and is writable, otherwise ./data
# or the directory of an absolute DB_PATH.
DATA_DIR=

# Comma-separated default recipients for Send Report Now when the form is empty.
REPORT_RECIPIENTS=
