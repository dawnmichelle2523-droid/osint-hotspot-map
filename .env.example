# xAI API key for server-side Grok calls. Never commit a real key.
# Server only: do not put this in HTML, JavaScript, or any API response.
XAI_API_KEY=

# Optional Anthropic Claude key for on-demand drafts only.
# Used when someone clicks Draft with Claude. Never called by pollers or page loads.
# ANTHROPIC_API_KEY is preferred. If it is unset or blank, the exact name
# GeoRiskGlobal is read next, then the legacy name GeoRiskIntel. That legacy
# name is the current Vercel Production secret. GEORISKGLOBAL and
# GEORISKINTEL are not the same variables.
# Never commit a real key. See docs/CLAUDE_INTEGRATION.md.
ANTHROPIC_API_KEY=
# GeoRiskGlobal=
# GeoRiskIntel=
# Optional model overrides. Defaults are claude-sonnet-5-5 and claude-haiku-5-5.
CLAUDE_RA_MODEL=
CLAUDE_BRIEF_MODEL=

# Placeholder only. Not a real NASA key. Do not commit a real key.
FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# Pre-launch lock. Leave PREVIEW_PASSWORD empty for a public site.
# At launch, remove PREVIEW_PASSWORD and set ALLOW_INDEXING=true.
# The password is read only from the environment. Do not commit a real value.
PREVIEW_PASSWORD=
# Default preview username is unchanged so existing preview access keeps working.
PREVIEW_USER=georiskintel
ALLOW_INDEXING=
SITE_PRIVATE_MODE=

# Signs single-region pass links. Never commit a real value.
PPV_SECRET=

# Public origin for Slack "View on Live Map" links. Example: https://map.example.com
PUBLIC_BASE_URL=

# Okta OIDC (Authorization Code + PKCE) and the Okta dashboard tile.
# Leave OKTA_ISSUER and OKTA_CLIENT_ID empty to keep the current preview.
# Issuer example: https://your-org.okta.com/oauth2/default
# The client secret is read only from the environment. Do not commit a real value.
OKTA_ISSUER=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
# Optional. Defaults to {public origin}/auth/okta/callback
OKTA_REDIRECT_URI=
# Optional comma-separated groups. The ID token must include at least one.
OKTA_ALLOWED_GROUPS=

# Optional path for the Slack alerts database.
# Defaults to /data/slack_alerts.db when /data is writable, otherwise ./slack_alerts.db
# SLACK_ALERTS_DB=

# Optional SMTP for the 07:00 Europe/London briefings and intelligence reports.
# SMTP_PASS is accepted as an alias of SMTP_PASSWORD. Leave blank to skip email.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# Durable directory for incidents.db. On Railway, mount a volume at /data.
# When unset, /data is used if it exists and is writable, otherwise ./data
# or the directory of an absolute DB_PATH.
DATA_DIR=

# Comma-separated default recipients for Send Report Now when the form is empty.
REPORT_RECIPIENTS=

# Daily Area of Operations publisher. Leave both secrets empty to allow the
# same-origin briefing page to publish. When either is set, POST /api/briefings/publish
# requires Authorization: Bearer <secret>. The morning workflow never sets use_claude.
# CRON_SECRET=
# PUBLISH_SECRET=
# Comma-separated AO slugs. Default: syria,sudan,middle-east,ukraine,sahel
# GEORISKINTEL_SUBSCRIBED_AOS=
# Public origin for the GitHub Actions morning publisher. Example: https://map.example.com
# GEORISKINTEL_BASE_URL=

# ReliefWeb API v2 application name. Public identifier, not a secret.
# The Sudan JSON feed is skipped, with a log line, when this is empty.
# RELIEFWEB_APPNAME=

# X account fetching is off. Set to true only when a paid X source is enabled.
# Dead Nitter and xcancel mirrors are not called.
# ENABLE_X_FEEDS=false

# Background and scheduled model calls (Grok sweep, ingest translation, scheduled briefs) stay off.
# On-demand drafts are separate. Leave unset.
# ENABLE_BACKGROUND_XAI=false

# Check-in event retention (UK/EU GDPR Art. 5(1)(e)). Default 30 days.
# CHECKIN_RETENTION_DAYS=30
# Optional path for the check-in database.
# Defaults to /data/checkins.db when /data is writable, otherwise ./checkins.db
# CHECKIN_DB_PATH=
